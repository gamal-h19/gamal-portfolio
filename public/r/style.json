  "files": [],
  "cssVars": {
    "theme": {
      "color-line": "color-mix(in oklab, var(--border) 64%, var(--background))"
    }
  },
  "css": {
    "@utility screen-line-top": {
      "@apply relative before:absolute before:top-0 before:left-1/2 before:-z-1 before:h-px before:w-screen before:-translate-x-1/2 before:bg-line": {}
    },
    "@utility screen-line-bottom": {
      "@apply relative after:absolute after:bottom-0 after:left-1/2 after:-z-1 after:h-px after:w-screen after:-translate-x-1/2 after:bg-line": {}
    }
  },
  "type": "registry:style"
}